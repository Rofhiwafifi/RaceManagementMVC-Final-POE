@model List<RaceManagementMVC.Models.resultModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">

    <h1>My Race Results</h1>

    <p>View your race history and finishing positions.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You do not have any published results yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Finishers</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.eventName</td>

                            <td>
                                @result.eventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@result.categoryName</td>

                            <td>@result.finishTime</td>

                            <td>
                                @result.position
                            </td>

                            <td>
                                @if (result.totalFinishers > 0)
                                {
                                    <span>
                                        @result.position out of
                                        @result.totalFinishers
                                    </span>
                                }
                                else
                                {
                                    <span>Not available</span>
                                }
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
