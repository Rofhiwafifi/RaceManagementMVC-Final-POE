@model List<RaceManagementMVC.Models.enrolmentModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <h1>My Enrolments</h1>

    <p>View the events you have registered for.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.eventName</td>

                            <td>@enrolment.categoryName</td>

                            <td>
                                @enrolment.enrolmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (enrolment.status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @enrolment.status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (enrolment.status != "Cancelled")
                                {
                                    <form asp-action="Cancel"
                                          asp-route-eventId="@enrolment.eventId"
                                          method="post"
                                          onsubmit="return confirm('Cancel this enrolment?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Cancel
                                        </button>

                                    </form>
                                }
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>