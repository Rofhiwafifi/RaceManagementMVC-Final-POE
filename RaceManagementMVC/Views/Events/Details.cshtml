@model RaceManagementMVC.Models.eventModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    <h1>@Model.eventName</h1>

    @if (!string.IsNullOrEmpty(Model.bannerImageUrl))
    {
        <img src="@Model.bannerImageUrl"
             class="img-fluid rounded mb-4"
             style="max-height:350px;"
             alt="Event banner" />
    }

    <p>@Model.description</p>

    <p><strong>Date:</strong> @Model.eventDate.ToString("dd MMMM yyyy")</p>
    <p><strong>Start Time:</strong> @Model.startTime</p>
    <p><strong>Venue:</strong> @Model.venue</p>
    <p><strong>Distance:</strong> @Model.distance km</p>
    <p><strong>Event Type:</strong> @Model.eventType</p>
    <p><strong>Maximum Participants:</strong> @Model.maxParticipants</p>
    <p><strong>Status:</strong> @Model.status</p>

    @if (Context.Session.GetString("role") == "Participant")
    {
        <a asp-controller="Enrolments"
           asp-action="Enrol"
           asp-route-eventId="@Model.eventId"
           class="btn btn-primary">
            Enrol in this Event
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Back to Events
    </a>

</div>
