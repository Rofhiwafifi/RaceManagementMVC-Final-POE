@model List<RaceManagementMVC.Models.eventModel>

@{
    ViewData["Title"] = "Race Events";
    string role = Context.Session.GetString("role") ?? "";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Race Events</h1>
            <p>View and manage available races.</p>
        </div>

        @if (role == "Organiser")
        {
            <a asp-action="Create" class="btn btn-primary">
                Create Event
            </a>
            
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(raceEvent.bannerImageUrl))
                        {
                            <img src="@raceEvent.bannerImageUrl"
                                 class="card-img-top"
                                 style="height:180px; object-fit:cover;"
                                 alt="Event banner" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @raceEvent.eventName
                            </h5>

                            <p class="card-text">
                                @raceEvent.description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.eventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @raceEvent.venue
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @raceEvent.distance km
                            </p>

                            <p>
                                <strong>Status:</strong>
                                @raceEvent.status
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@raceEvent.eventId"
                               class="btn btn-outline-primary">
                                View Details
                            </a>

                            @if (role == "Organiser")
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@raceEvent.eventId"
                                   class="btn btn-warning">
                                    Edit
                                </a>
                                <a asp-controller="Enrolments"
                                   asp-action="Index"
                                   asp-route-eventId="@raceEvent.eventId"
                                   class="btn btn-info">
                                    View Enrolments
                                </a>

                                <a asp-controller="Results"
                                   asp-action="Index"
                                   asp-route-eventId="@raceEvent.eventId"
                                   class="btn btn-success">
                                    Manage Results
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@raceEvent.eventId"
                                      method="post"
                                      class="mt-2"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Delete
                                    </button>

                                </form>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>